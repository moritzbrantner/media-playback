{
  "name": "@moritzbrantner/media-playback",
  "version": "0.1.0",
  "description": "Headless media playback primitives with explicit clock and seek semantics.",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "check-types": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "verify": "bun run format:check && bun run lint && bun run check-types && bun run test && bun run build"
  },
  "devDependencies": {
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
